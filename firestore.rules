rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 這個 Firebase 專案同時給 cheryl-vocab（students）與 feige-vocab（feige_students）
    // 兩個網站共用，只公開開放這兩棵樹，其他路徑一律拒絕。
    // 家庭背單字用途，沒有帳號登入機制，資料本身也不涉及個資或金錢，
    // 用公開讀寫換取「不用另外做登入系統」的簡單性。
    match /students/{studentId} {
      allow read, write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    match /feige_students/{studentId} {
      allow read, write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // bw-grammar-daily：使用者自己的每日文法/中翻英練習，單人使用，無姓名選擇機制。
    match /self_grammar/{trackId} {
      allow read, write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // fire-engineer-exam：消防設備師/士測驗複習網頁，使用者自己的作答進度，單人使用。
    match /fire_exam/{subjectId} {
      allow read, write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // 11501八信單字書：改用Google登入限制讀取（不像其餘樹狀結構公開），
    // 只有白名單信箱才能讀到這批資料。目前只有使用者本人一組帳號。
    function isAllowedEmail() {
      return request.auth != null &&
        request.auth.token.email in ['iw661001@gmail.com'];
    }
    match /word_exams/{examId} {
      allow read, write: if isAllowedEmail();

      match /{subcollection=**} {
        allow read, write: if isAllowedEmail();
      }
    }
  }
}
